          "pluginVersion": "4.17.0",
          "queryType": "timeseries",
          "rawSql": "SELECT\n    window_start AS time,\n    concat(symbol, ' VWAP') AS metric,\n    vwap\nFROM vwap_aggregations FINAL\nWHERE window_start >= $__fromTime\n  AND window_start <= $__toTime\nORDER BY time ASC",
