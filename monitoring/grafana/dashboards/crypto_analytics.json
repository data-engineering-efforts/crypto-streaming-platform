            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-datasource"
          },
          "rawSql": "SELECT\n    symbol,\n    streaming_vwap,\n    batch_vwap,\n    diff_pct,\n    status,\n    run_time\nFROM recon_results FINAL\nWHERE (symbol, run_time) IN (\n    SELECT symbol, max(run_time)\n    FROM recon_results FINAL\n    GROUP BY symbol\n)\nORDER BY symbol",
